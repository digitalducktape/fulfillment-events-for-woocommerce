<?xml version="1.0"?>
<ruleset name="Fulfillment Events for WooCommerce">
	<description>Coding standards for Fulfillment Events for WooCommerce.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress-Extra">
		<!-- Files are named class-fe-*.php, matching WordPress convention; keep the check on. -->
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fulfillment-events-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fe"/>
				<element value="Fe_"/>
				<element value="FE_"/>
			</property>
		</properties>
	</rule>
</ruleset>
